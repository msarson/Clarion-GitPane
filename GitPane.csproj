<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net40</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <OutputType>Library</OutputType>
    <AssemblyName>GitPane</AssemblyName>
    <RootNamespace>GitPane</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultItems>false</EnableDefaultItems>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Default CLARION_ROOT to test environment if not set -->
    <CLARION_ROOT Condition="'$(CLARION_ROOT)' == ''">F:\development\ExtensionTesting\Clarion</CLARION_ROOT>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="GitPanePad.cs" />
    <Compile Include="GitRepository.cs" />
    <Compile Include="BranchSelectorDialog.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="ICSharpCode.Core">
      <HintPath>$(CLARION_ROOT)\bin\ICSharpCode.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ICSharpCode.SharpDevelop">
      <HintPath>$(CLARION_ROOT)\bin\ICSharpCode.SharpDevelop.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>


