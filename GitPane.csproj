<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net40</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <OutputType>Library</OutputType>
    <AssemblyName>GitPane</AssemblyName>
    <RootNamespace>GitPane</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultItems>false</EnableDefaultItems>
    <!-- Single source of truth for the version. AssemblyInfo.cs must match, and the
         CheckAddinVersion target below fails the build if the .addin manifest does not. -->
    <Version>1.0.9</Version>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Default CLARION_ROOT to test environment if not set -->
    <CLARION_ROOT Condition="'$(CLARION_ROOT)' == ''">F:\development\ExtensionTesting\Clarion</CLARION_ROOT>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\GitPaneIcon.png" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="RegisterIconsCommand.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="GitPanePad.cs" />
    <Compile Include="GitPanePad.Designer.cs" />
    <Compile Include="GitPanePad.BranchManagement.cs" />
    <Compile Include="GitPanePad.CommitOperations.cs" />
    <Compile Include="GitPanePad.FileSystemWatchers.cs" />
    <Compile Include="GitPanePad.RemoteManagement.cs" />
    <Compile Include="GitPanePad.RepositoryDialogs.cs" />
    <Compile Include="GitRepository.cs" />
    <Compile Include="BranchSelectorDialog.cs" />
    <Compile Include="GitHistoryDialog.cs" />
    <Compile Include="GitTemplate.cs" />
    <Compile Include="TemplateManager.cs" />
    <Compile Include="TemplateEditorDialog.cs" />
    <Compile Include="TemplateManagerDialog.cs" />
    <Compile Include="InitializeRepositoryDialog.cs" />
    <Compile Include="ApplyTemplateDialog.cs" />
    <Compile Include="MergeConflictDialog.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="Microsoft.VisualBasic" />
    <Reference Include="ICSharpCode.Core">
      <HintPath>$(CLARION_ROOT)\bin\ICSharpCode.Core.dll</HintPath>
      <Private>false</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
    <Reference Include="ICSharpCode.SharpDevelop">
      <HintPath>$(CLARION_ROOT)\bin\ICSharpCode.SharpDevelop.dll</HintPath>
      <Private>false</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
  </ItemGroup>

  <!-- The .addin manifest is hand-maintained, and it drifts. FlattenCode shipped 1.0.1, 1.0.2 and
       1.0.3 all declaring version="1.0", which left Addin Finder offering an update that installing
       could never clear. A stale version is not visible at build time unless something looks, so
       this fails the Release build rather than letting another release go out wrong.

       Deliberately a check and not a rewriter: a build step that edits the manifest would hide the
       mistake instead of making someone fix it, and a bad regex would corrupt the file silently. -->
  <Target Name="CheckAddinVersion" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <AddinManifest>$(MSBuildProjectDirectory)\GitPane.addin</AddinManifest>
      <AddinManifestText>$([System.IO.File]::ReadAllText('$(AddinManifest)'))</AddinManifestText>
    </PropertyGroup>
    <Error Condition="!$(AddinManifestText.Contains('version=&quot;$(Version)&quot;'))"
           Text="GitPane.addin does not declare version=&quot;$(Version)&quot;. Update the &lt;Identity&gt; element to match, or Addin Finder will keep offering an update that installing cannot clear." />
    <Message Importance="high" Text="GitPane.addin declares version $(Version) - ok" />
  </Target>
</Project>


