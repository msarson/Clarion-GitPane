<?xml version="1.0" encoding="utf-8"?>
<AddIn name="GitPane"
       author="Clarion Community"
       description="Visual Git operations pane for Clarion IDE"
       addInManagerHidden="preinstalled">

  <Manifest>
    <Identity name="GitPane"/>
  </Manifest>

  <Runtime>
    <Import assembly="GitPane.dll"/>
  </Runtime>

  <Path name="/Workspace/Autostart">
    <Class id="GitPaneRegisterIcons" class="GitPane.RegisterIconsCommand"/>
  </Path>

  <Path name="/SharpDevelop/Workbench/Pads">
    <Pad id="GitPane"
         category="Main"
         title="Git Pane"
         icon="GitPane.GitPaneIcon"
         shortcut="Control|Alt|G"
         class="GitPane.GitPanePad"/>
  </Path>

</AddIn>
